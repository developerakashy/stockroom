{
  "name": "commerce-order-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --import tsx backend/server.ts\" vite",
    "db:generate": "drizzle-kit generate",
    "seed": "node --import tsx backend/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "biome check . && tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx backend/server.ts",
    "test:consistency": "node --import tsx --test tests/consistency.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-fastify": "^11.2.11",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lucide-react": "^1.77.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
